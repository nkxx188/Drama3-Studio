+void Drama3Generator::reserve_context(int64_t cache_steps) {
+    if (cache_steps <= cache_steps_) return;
+    if (cache_steps > 8192) throw runtime::InvalidRequestError("Live context resize supports at most 8192 rows");
+    cached_prefix_.clear();
+    cached_hidden_.clear();
+    decoder_.reset();
+    backbone_->reserve_context(cache_steps);
+    tower_->reserve_context(cache_steps);
+    decoder_ = backbone_->create_decode_session(cache_steps);
+    cache_steps_ = cache_steps;
+    debug::timing_log_scalar("drama3.context_capacity", cache_steps_);
+}
