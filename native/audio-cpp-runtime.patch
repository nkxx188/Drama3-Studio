+TensorValue DiskExpertWeightStore::host_tensor(size_t group_id, size_t projection_id) {
+    auto & group = *impl_->groups.at(group_id);
+    const auto & projection = group.projections.at(projection_id);
+    const auto key = std::make_pair(group_id, projection_id);
+    auto & tensor = impl_->host_views[key];
+    if (!tensor) {
+        if (!impl_->host_view_context) {
+            impl_->host_view_context.reset(ggml_init({4 * 1024 * 1024, nullptr, true}));
+            if (!impl_->host_view_context) throw std::runtime_error("cannot create host expert view context");
+        }
+        tensor = ggml_new_tensor_3d(impl_->host_view_context.get(), projection.type,
+                                   projection.input, projection.output, projection.experts);
+        auto * data = const_cast<std::byte *>(projection.host_data ? projection.host_data :
+            impl_->mapped_file.data() + projection.offset);
+        auto * buffer = ggml_backend_cpu_buffer_from_ptr(data, ggml_nbytes(tensor));
+        if (!buffer) throw std::runtime_error("cannot wrap native host expert source");
+        impl_->host_view_buffers.push_back(buffer);
+        ggml_backend_buffer_set_usage(buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        if (ggml_backend_tensor_alloc(buffer, tensor, data) != GGML_STATUS_SUCCESS)
+            throw std::runtime_error("cannot bind native host expert source");
+    }
+    return wrap_tensor(tensor, TensorShape::from_dims({tensor->ne[2], tensor->ne[1], tensor->ne[0]}), tensor->type);
+}
