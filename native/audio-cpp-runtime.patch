+            throw std::runtime_error("cannot allocate cooperative decoder contexts");
+        hidden_ = ggml_new_tensor_3d(inputs_.get(), GGML_TYPE_F32, h, 1, 1);
+        residual_ = ggml_new_tensor_3d(inputs_.get(), GGML_TYPE_F32, h, 1, 1);
+        shared_ = ggml_new_tensor_2d(inputs_.get(), GGML_TYPE_F32, h, 1);
+        scales_ = ggml_new_tensor_2d(inputs_.get(), GGML_TYPE_F32, k, 1);
+        ids_ = ggml_new_tensor_2d(inputs_.get(), GGML_TYPE_I32, k, 1);
+        gpu_slots_ = ggml_new_tensor_2d(inputs_.get(), GGML_TYPE_I32, k, 1);
+        gpu_lanes_ = ggml_new_tensor_1d(inputs_.get(), GGML_TYPE_I32, k);
+        cpu_lanes_ = ggml_new_tensor_1d(inputs_.get(), GGML_TYPE_I32, k);
+        partial_ = ggml_new_tensor_2d(inputs_.get(), GGML_TYPE_F32, h, k);
+        uploaded_ = ggml_new_tensor_2d(inputs_.get(), GGML_TYPE_F32, h, k);
+        final_hidden_ = ggml_new_tensor_3d(inputs_.get(), GGML_TYPE_F32, h, 1, 1);
+        for (auto * t : {hidden_, residual_, shared_, scales_, ids_, gpu_slots_, gpu_lanes_,
+                         cpu_lanes_, partial_, uploaded_, final_hidden_}) ggml_set_input(t);
+        device_buffer_.reset(ggml_backend_alloc_ctx_tensors(inputs_.get(), execution.backend()));
+        cpu_x_ = ggml_new_tensor_3d(cpu_inputs_.get(), GGML_TYPE_F32, h, 1, 1);
+        cpu_ids_ = ggml_new_tensor_2d(cpu_inputs_.get(), GGML_TYPE_I32, k, 1);
+        cpu_output_ = ggml_new_tensor_2d(cpu_inputs_.get(), GGML_TYPE_F32, h, k);
+        for (auto * t : {cpu_x_, cpu_ids_, cpu_output_}) ggml_set_input(t);
+        host_buffer_.reset(ggml_backend_alloc_ctx_tensors(cpu_inputs_.get(), cpu_.backend()));
+        const auto pinned_type = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(execution.backend()));
+        if (!pinned_type) throw std::runtime_error("cooperative decode requires CUDA host buffers");
+        handoff_.reset(ggml_backend_buft_alloc_buffer(pinned_type, (h + h * k) * sizeof(float) + k * sizeof(int32_t)));
+        if (!device_buffer_ || !host_buffer_ || !handoff_ ||
+            ggml_backend_buffer_get_type(handoff_.get()) != pinned_type)
+            throw std::runtime_error("cannot allocate bounded cooperative handoff");
+        host_x_ = static_cast<float *>(ggml_backend_buffer_get_base(handoff_.get()));
+        host_partial_ = host_x_ + h;
+        host_ids_ = reinterpret_cast<int32_t *>(host_partial_ + h * k);
+        core::ModuleBuildContext ctx{context_.get(), "drama3_backbone.hybrid_decode", execution.backend_type()};
+        const auto shape = core::TensorShape::from_dims({1, 1, h});
+        auto x = core::wrap_tensor(x_, shape);
+        auto pos = core::wrap_tensor(positions, core::TensorShape::from_dims({1}), GGML_TYPE_I32);
+        auto slot = core::wrap_tensor(cache_slot, core::TensorShape::from_dims({1}), GGML_TYPE_I32);
+        auto attention_mask = core::wrap_tensor(mask,
+            core::TensorShape::from_dims({1, 1, 1, cache_steps}), GGML_TYPE_F16);
+        size_t full = 0, linear = 0;
+        for (size_t index = 0; index < weights.layers.size(); ++index) {
+            const auto & layer = weights.layers[index];
+            auto * route = ggml_new_graph_custom(ctx.ggml, 1024, false);
+            auto attention = round_activation(ctx,
+                modules::GemmaRMSNormModule({h, config.rms_norm_eps, true, false}).build(ctx, x, layer.input_norm), config);
+            if (layer.full_attention) {
+                attention = full_attention_cached(ctx, attention, pos, slot, attention_mask,
+                    core::wrap_tensor(keys.at(full), core::TensorShape::from_dims(
+                        {1, cache_steps, config.kv_heads, config.head_dim})),
+                    core::wrap_tensor(values.at(full), core::TensorShape::from_dims(
+                        {1, cache_steps, config.kv_heads, config.head_dim})), *layer.full, config);
+                ++full;
+            } else {
+                const auto state_size = ggml_nelements(states.at(linear));
+                auto out = linear_attention_cached(ctx, attention,
+                    core::wrap_tensor(tails.at(linear), core::TensorShape::from_dims(
+                        {1, tails.at(linear)->ne[1], tails.at(linear)->ne[0]})),
+                    core::wrap_tensor(states.at(linear), core::TensorShape::from_dims({1, 1, state_size})),
+                    *layer.linear, config);
+                ggml_build_forward_expand(route, ggml_cpy(ctx.ggml, out.next_conv_tail.tensor, tails.at(linear)));
+                ggml_build_forward_expand(route, ggml_cpy(ctx.ggml, out.next_recurrent_state.tensor, states.at(linear)));
+                attention = std::move(out.output);
+                ++linear;
+            }
+            auto residual = round_activation(ctx, modules::AddModule{}.build(ctx, x, attention), config);
+            auto normalized = round_activation(ctx,
+                modules::GemmaRMSNormModule({h, config.rms_norm_eps, true, false})
+                    .build(ctx, residual, layer.post_norm), config);
+            const auto moe = build_moe_inputs(ctx, normalized, layer, config);
+            for (const auto & pair : std::vector<std::pair<ggml_tensor *, ggml_tensor *>>{
+                     {residual.tensor, residual_}, {normalized.tensor, hidden_}, {moe.scales, scales_}, {moe.ids, ids_}})
+                ggml_build_forward_expand(route, ggml_cpy(ctx.ggml, pair.first, pair.second));
+            route_graphs_.push_back(route); gpu_graphs_.push_back(route);
+            auto * shared = ggml_new_graph_custom(ctx.ggml, 128, false);
+            ggml_build_forward_expand(shared, ggml_cpy(ctx.ggml,
+                build_shared_expert(ctx, core::wrap_tensor(hidden_, shape), layer, config), shared_));
+            shared_graphs_.push_back(shared); gpu_graphs_.push_back(shared);
+            std::array<ggml_tensor *, 3> host_weights{};
+            for (size_t projection = 0; projection < 3; ++projection) {
+                host_weights[projection] = weights.disk_store->host_tensor(layer.disk_group, projection).tensor;
+                if (host_weights[projection]->type != GGML_TYPE_Q8_0)
+                    throw std::runtime_error("cooperative decode currently requires Q8_0 expert weights");
+            }
+            std::vector<ggml_cgraph *> gpu_counts(9), cpu_counts(9);
+            for (int count = 1; count <= 8; ++count) {
+                auto * graph = ggml_new_graph_custom(ctx.ggml, 128, false);
+                auto * slots = ggml_view_2d(ctx.ggml, gpu_slots_, count, 1, count * sizeof(int32_t), 0);
+                auto * gate = ggml_mul_mat_id(ctx.ggml, layer.expert_gate.tensor, hidden_, slots);
+                auto * up = ggml_mul_mat_id(ctx.ggml, layer.expert_up.tensor, hidden_, slots);
+                auto * activated = ggml_mul(ctx.ggml, ggml_silu(ctx.ggml, gate), up);
+                auto * output = ggml_mul_mat_id(ctx.ggml, layer.expert_down.tensor, activated, slots);
+                auto * lanes = ggml_view_1d(ctx.ggml, gpu_lanes_, count, 0);
+                ggml_build_forward_expand(graph, ggml_set_rows(ctx.ggml, partial_,
+                    ggml_reshape_2d(ctx.ggml, output, h, count), lanes));
+                gpu_counts[count] = graph; gpu_graphs_.push_back(graph);
+                auto * cpu_ctx = cpu_context_.get();
+                graph = ggml_new_graph_custom(cpu_ctx, 128, false);
+                auto * ids = ggml_view_2d(cpu_ctx, cpu_ids_, count, 1, count * sizeof(int32_t), 0);
+                auto * cpu_input = compatible_quantization_ ? compatible_quantize(cpu_ctx, cpu_x_, &input_guard_) : cpu_x_;
+                gate = ggml_mul_mat_id(cpu_ctx, host_weights[0], cpu_input, ids);
+                up = ggml_mul_mat_id(cpu_ctx, host_weights[1], cpu_input, ids);
+                activated = ggml_mul(cpu_ctx, ggml_silu(cpu_ctx, gate), up);
+                if (compatible_quantization_) activated = compatible_quantize(cpu_ctx, activated, &activation_guard_);
+                output = ggml_mul_mat_id(cpu_ctx, host_weights[2], activated, ids);
+                auto * destination = ggml_view_2d(cpu_ctx, cpu_output_, h, count, h * sizeof(float), 0);
+                ggml_build_forward_expand(graph, ggml_cpy(cpu_ctx,
+                    ggml_reshape_2d(cpu_ctx, output, h, count), destination));
+                cpu_counts[count] = graph; cpu_graphs_.push_back(graph);
+            }
+            gpu_experts_.push_back(std::move(gpu_counts));
+            cpu_experts_.push_back(std::move(cpu_counts));
+        }
+        cpu_scatter_.resize(9);
+        for (int count = 1; count <= 8; ++count) {
+            auto * graph = ggml_new_graph_custom(ctx.ggml, 64, false);
+            auto * values = ggml_view_2d(ctx.ggml, uploaded_, h, count, h * sizeof(float), 0);
+            ggml_build_forward_expand(graph, ggml_set_rows(ctx.ggml, partial_, values,
+                ggml_view_1d(ctx.ggml, cpu_lanes_, count, 0)));
+            cpu_scatter_[count] = graph; gpu_graphs_.push_back(graph);
+        }
+        finish_ = ggml_new_graph_custom(ctx.ggml, 128, false);
+        auto * partial = ggml_reshape_3d(ctx.ggml, partial_, h, k, 1);
+        auto * weighted = ggml_mul(ctx.ggml, partial, ggml_reshape_3d(ctx.ggml, scales_, 1, k, 1));
+        auto * reduced = ggml_cont(ctx.ggml, ggml_permute(ctx.ggml, weighted, 1, 0, 2, 3));
+        reduced = ggml_reshape_2d(ctx.ggml, ggml_sum_rows(ctx.ggml, reduced), h, 1);
+        auto combined = round_activation(ctx,
+            core::wrap_tensor(ggml_reshape_3d(ctx.ggml, ggml_add(ctx.ggml, reduced, shared_), h, 1, 1), shape), config);
+        combined = round_activation(ctx,
+            modules::AddModule{}.build(ctx, core::wrap_tensor(residual_, shape), combined), config);
+        ggml_build_forward_expand(finish_, ggml_cpy(ctx.ggml, combined.tensor, x_));
+        gpu_graphs_.push_back(finish_);
+        final_ = ggml_new_graph_custom(ctx.ggml, 128, false);
+        auto normalized = round_activation(ctx,
+            modules::GemmaRMSNormModule({h, config.rms_norm_eps, true, false}).build(ctx, x, weights.final_norm), config);
+        ggml_build_forward_expand(final_, ggml_cpy(ctx.ggml, normalized.tensor, final_hidden_));
+        gpu_graphs_.push_back(final_);
+        plan(execution_, gpu_graphs_, gpu_allocator_, nullptr);
+        plan(cpu_, cpu_graphs_, cpu_allocator_, &cpu_plans_);
+        policies_.resize(weights.layers.size());
+        profile_key_ = weights.source_identity + "|" + std::to_string(config.expert_cache_size) + "|" +
+            std::to_string(cache_steps) + "|" + std::to_string(cpu_.config().threads) + "|decode-v6-rank4-safe024-guard8e5|" +
+            ggml_backend_dev_description(ggml_backend_get_device(cpu_.backend())) + "|" +
+            ggml_backend_dev_description(ggml_backend_get_device(execution_.backend()));
+        if (const auto * identifier = std::getenv("PROCESSOR_IDENTIFIER")) profile_key_ += "|" + std::string(identifier);
+        profile_key_ += compatible_quantization_ ? "|cuda-round" : "|ggml-round";
+        if (!config.decode_profile.empty()) {
+            uint64_t key_hash = 14695981039346656037ull;
+            for (const auto byte : profile_key_) { key_hash ^= static_cast<unsigned char>(byte); key_hash *= 1099511628211ull; }
+            const auto prefix = std::filesystem::path(config.decode_profile);
+            profile_path_ = prefix.has_extension()
+                ? prefix.parent_path() / (prefix.stem().string() + "-" + std::to_string(key_hash) + ".json")
+                : prefix / ("decode-" + std::to_string(key_hash) + ".json");
+        }
+        load_profile();
+        worker_ = std::make_unique<Drama3ExpertWorker>();
+    }
+    ~Drama3HybridDecodeGraph() {
+        worker_.reset();
+        ggml_backend_synchronize(execution_.backend());
+        for (auto * graph : gpu_graphs_) core::release_backend_graph_resources(execution_.backend(), graph, true);
+        cpu_plans_.clear();
+        debug::timing_log_scalar("drama3.hybrid.cpu_expert_jobs", cpu_jobs_);
+        debug::timing_log_scalar("drama3.hybrid.gpu_expert_jobs", gpu_jobs_);
+        debug::timing_log_scalar("drama3.hybrid.guarded_expert_jobs", guarded_jobs_);
+    }
+    std::vector<float> run() {
+        const auto h = config_.hidden_size;
+        for (size_t layer = 0; layer < route_graphs_.size(); ++layer) {
+            compute(route_graphs_[layer]);
+            ggml_backend_tensor_get_async(execution_.backend(), ids_, host_ids_, 0, 8 * sizeof(int32_t));
+            if (!pipeline_width_)
+                ggml_backend_tensor_get_async(execution_.backend(), hidden_, host_x_, 0, h * sizeof(float));
+            ggml_backend_synchronize(execution_.backend());
+            auto & policy = policies_[layer];
+            const bool calibrating = config_.decode_cpu_experts == -1 && policy.chosen < 0;
+            const int candidate = calibrating ? policy.calls % 3 : policy.chosen;
+            const int budget = config_.decode_cpu_experts >= 0 ? static_cast<int>(config_.decode_cpu_experts) :
+                candidate == 0 ? 0 : candidate == 1 ? 2 : 4;
+            const bool keep_hits = config_.decode_cpu_experts >= 0 ? config_.decode_keep_hits : true;
+            const auto started = std::chrono::steady_clock::now();
+            const auto resident = weights_.disk_store->resident_ids(weights_.layers[layer].disk_group);
+            std::vector<int32_t> cpu_ids, cpu_lanes, gpu_ids, gpu_lanes;
+            // Retain the leading half of routing contributions on GPU.
+            // Preserving hits alone can otherwise send a cold top-1 to CPU
+            // when several lower-ranked experts happen to be resident.
+            const int first_cpu_lane = config_.decode_cpu_experts == -1 || budget <= 4 ? 4 : 0;
+            for (int lane = 7; lane >= first_cpu_lane && cpu_lanes.size() < static_cast<size_t>(budget); --lane)
+                if (!keep_hits || std::find(resident.begin(), resident.end(), host_ids_[lane]) == resident.end())
+                    cpu_lanes.push_back(lane);
+            std::sort(cpu_lanes.begin(), cpu_lanes.end());
+            for (int lane = 0; lane < 8; ++lane) {
+                if (std::find(cpu_lanes.begin(), cpu_lanes.end(), lane) != cpu_lanes.end()) cpu_ids.push_back(host_ids_[lane]);
+                else { gpu_ids.push_back(host_ids_[lane]); gpu_lanes.push_back(lane); }
+            }
+            boundary_mask_.store(0, std::memory_order_relaxed);
+            if (!cpu_ids.empty()) worker_->launch([this, layer, cpu_ids] {
+                ggml_backend_tensor_set(cpu_x_, host_x_, 0, config_.hidden_size * sizeof(float));
+                ggml_backend_tensor_set(cpu_ids_, cpu_ids.data(), 0, cpu_ids.size() * sizeof(int32_t));
+                auto * graph = cpu_experts_[layer][cpu_ids.size()];
+                if (core::compute_graph(cpu_, graph, cpu_plans_.at(graph)) != GGML_STATUS_SUCCESS)
+                    throw std::runtime_error("native CPU expert execution failed");
+                ggml_backend_tensor_get(cpu_output_, host_partial_, 0,
+                    config_.hidden_size * cpu_ids.size() * sizeof(float));
+            });
+            // Submit shared GPU work while CPU experts and weight gathering proceed.
+            compute(shared_graphs_[layer]);
+            try {
+                if (!gpu_ids.empty()) {
+                    if (pipeline_width_) {
+                        size_t sequence = 0;
+                        weights_.disk_store->stage_pipeline(weights_.layers[layer].disk_group, gpu_ids, pipeline_width_,
+                            [&](const std::vector<int32_t> & slots, const std::vector<int32_t> & lanes) {
+                                // Keep async source bytes alive until next layer's
+                                // necessary route readback has completed.
+                                auto & stable_slots = pipeline_slots_.at(sequence);
+                                auto & stable_lanes = pipeline_lanes_.at(sequence++);
+                                std::copy(slots.begin(), slots.end(), stable_slots.begin());
+                                std::copy(lanes.begin(), lanes.end(), stable_lanes.begin());
+                                ggml_backend_tensor_set_async(execution_.backend(), gpu_slots_, stable_slots.data(),
+                                                              0, slots.size() * sizeof(int32_t));
+                                ggml_backend_tensor_set_async(execution_.backend(), gpu_lanes_, stable_lanes.data(),
+                                                              0, lanes.size() * sizeof(int32_t));
+                                compute(gpu_experts_[layer][slots.size()]);
+                                if (std::getenv("DRAMA_GGUF_PIPELINE_SERIAL"))
+                                    ggml_backend_synchronize(execution_.backend());
+                            });
+                    } else {
+                        const auto slots = weights_.disk_store->stage(weights_.layers[layer].disk_group, gpu_ids);
+                        ggml_backend_tensor_set_async(execution_.backend(), gpu_slots_, slots.data(), 0, slots.size() * sizeof(int32_t));
+                        ggml_backend_tensor_set_async(execution_.backend(), gpu_lanes_, gpu_lanes.data(), 0, gpu_lanes.size() * sizeof(int32_t));
+                        compute(gpu_experts_[layer][gpu_ids.size()]);
+                    }
+                }
+                if (!cpu_ids.empty()) {
+                    worker_->wait();
+                    ggml_backend_tensor_set_async(execution_.backend(), uploaded_, host_partial_, 0,
+                        h * cpu_ids.size() * sizeof(float));
+                    ggml_backend_tensor_set_async(execution_.backend(), cpu_lanes_, cpu_lanes.data(), 0, cpu_lanes.size() * sizeof(int32_t));
+                    compute(cpu_scatter_[cpu_ids.size()]);
+                    const auto guarded = boundary_mask_.load(std::memory_order_relaxed);
+                    if (guarded) {
+                        std::vector<int32_t> retry_ids, retry_lanes;
+                        for (size_t i = 0; i < cpu_ids.size(); ++i)
+                            if (guarded & (1u << i)) { retry_ids.push_back(cpu_ids[i]); retry_lanes.push_back(cpu_lanes[i]); }
+                        const auto slots = weights_.disk_store->stage(weights_.layers[layer].disk_group, retry_ids);
+                        ggml_backend_tensor_set_async(execution_.backend(), gpu_slots_, slots.data(), 0, slots.size() * sizeof(int32_t));
+                        ggml_backend_tensor_set_async(execution_.backend(), gpu_lanes_, retry_lanes.data(), 0, retry_lanes.size() * sizeof(int32_t));
+                        compute(gpu_experts_[layer][retry_ids.size()]);
+                        guarded_jobs_ += retry_ids.size();
+                    }
+                }
+                compute(finish_);
+            } catch (...) {
+                if (!cpu_ids.empty()) worker_->wait();
+                throw;
+            }
+            cpu_jobs_ += cpu_ids.size(); gpu_jobs_ += gpu_ids.size();
+            if (calibrating) {
+                ggml_backend_synchronize(execution_.backend());
+                // First encounter warms graph capture and CPU plans. Later
+                // samples use real frames, without extra autoregressive work.
+                if (policy.calls >= 3) {
+                    policy.total[candidate] += debug::elapsed_ms(started);
+                    ++policy.samples[candidate];
+                }
+                if (++policy.calls >= 9) {
+                    policy.chosen = 0;
+                    for (int i = 1; i < 3; ++i)
+                        if (policy.total[i] / policy.samples[i] <
+                            policy.total[policy.chosen] / policy.samples[policy.chosen]) policy.chosen = i;
+                    debug::timing_log_scalar(("drama3.hybrid.layer_" + std::to_string(layer) + "_policy").c_str(), policy.chosen);
+                }
+            }
+        }
+        save_profile();
+        compute(final_);
+        ggml_backend_synchronize(execution_.backend());
+        return core::read_tensor_f32(final_hidden_);
+    }
+private:
+    size_t pipeline_width_ = 0;
+    std::array<std::array<int32_t, 8>, 4> pipeline_slots_{}, pipeline_lanes_{};
+    static void quantize_cuda_style(ggml_tensor * output, int ith, int nth, void * userdata) {
+        auto * guard = static_cast<QuantGuard *>(userdata);
+        const auto * input = output->src[0];
+        GGML_ASSERT(input->type == GGML_TYPE_F32 && ggml_is_contiguous(input));
+        const auto * values = static_cast<const float *>(input->data);
+        auto * target = static_cast<unsigned char *>(output->data);
+        const int64_t blocks = ggml_nelements(input) / 32;
+        for (int64_t block = ith; block < blocks; block += nth) {
+            float maximum = 0;
+            for (int i = 0; i < 32; ++i) maximum = std::max(maximum, std::abs(values[block * 32 + i]));
+            const float scale = maximum / 127.0F;
+            const auto half = ggml_fp32_to_fp16(scale);
+            std::memcpy(target + block * 34, &half, sizeof(half));
+            for (int i = 0; i < 32; ++i) {
+                const float scaled = scale == 0 ? 0 : values[block * 32 + i] / scale;
+                const float fraction = std::abs(scaled) - std::floor(std::abs(scaled));
+                if (std::abs(fraction - 0.5F) <= 0.00008F) {
+                    const unsigned int bit = guard->shared_input ? 0xffu :
+                        1u << static_cast<unsigned int>(block * 32 / input->ne[0]);
+                    guard->owner->boundary_mask_.fetch_or(bit, std::memory_order_relaxed);
+                }
+                const auto q = static_cast<int>(std::round(scaled));
+                target[block * 34 + 2 + i] = static_cast<unsigned char>(static_cast<int8_t>(std::max(-127, std::min(127, q))));
+            }
+        }
+    }
+    static ggml_tensor * compatible_quantize(ggml_context * ctx, ggml_tensor * input, QuantGuard * guard) {
+        ggml_tensor * args[] = {input};
+        return ggml_custom_4d(ctx, GGML_TYPE_Q8_0, input->ne[0], input->ne[1], input->ne[2], input->ne[3],
+            args, 1, quantize_cuda_style, GGML_N_TASKS_MAX, guard);
+    }
+    void compute(ggml_cgraph * graph) {
+        // All phases use one stream and one ordered workspace. Synchronize
+        // only at real CPU handoff/readback boundaries, not after every phase.
+        if (ggml_backend_graph_compute_async(execution_.backend(), graph) != GGML_STATUS_SUCCESS)
+            throw std::runtime_error("cooperative GPU phase failed");
+    }
+    static void plan(core::ExecutionContext & execution, const std::vector<ggml_cgraph *> & graphs,
+                     Allocator & allocator, std::map<ggml_cgraph *, core::HostGraphPlan> * plans) {
+        allocator.reset(ggml_gallocr_new(ggml_backend_get_default_buffer_type(execution.backend())));
+        ggml_cgraph * largest = nullptr;
+        size_t maximum = 0;
+        for (auto * graph : graphs) {
+            size_t bytes = 0;
+            ggml_gallocr_reserve_n_size(allocator.get(), graph, nullptr, nullptr, &bytes);
+            if (!largest || bytes > maximum) { largest = graph; maximum = bytes; }
+        }
+        if (!ggml_gallocr_reserve(allocator.get(), largest))
+            throw std::runtime_error("cannot reserve cooperative phase workspace");
+        for (auto * graph : graphs) {
+            if (!ggml_gallocr_reserve(allocator.get(), graph) || !ggml_gallocr_alloc_graph(allocator.get(), graph))
+                throw std::runtime_error("cannot allocate cooperative phase workspace");
+            if (plans) core::prepare_host_graph_plan(execution, graph, (*plans)[graph]);
+        }
+    }
+    void load_profile() {
+        if (config_.decode_cpu_experts != -1 || config_.decode_profile.empty()) return;
+        try {
+            const auto profile = io::json::parse_file(profile_path_);
+            if (io::json::require_string(profile, "key") != profile_key_) return;
+            const auto & values = profile.require("policies").as_array();
+            if (values.size() != policies_.size()) return;
+            for (const auto & value : values) if (value.as_i64() < 0 || value.as_i64() > 2) return;
+            for (size_t i = 0; i < values.size(); ++i) policies_[i].chosen = static_cast<int>(values[i].as_i64());
+            profile_saved_ = true;
+            debug::timing_log_scalar("drama3.hybrid.profile_hit", 1);
+        } catch (const std::exception &) {
+            // A missing/incomplete profile triggers bounded measurement.
+        }
+    }
+    void save_profile() {
+        if (profile_saved_ || config_.decode_cpu_experts != -1 || config_.decode_profile.empty()) return;
+        for (const auto & policy : policies_) if (policy.chosen < 0) return;
+        io::json::Value::Array values;
+        for (const auto & policy : policies_) values.push_back(io::json::Value::make_number(policy.chosen));
+        try {
+            const auto path = profile_path_;
+            if (path.has_parent_path()) std::filesystem::create_directories(path.parent_path());
+            const auto temporary = std::filesystem::path(path.string() + "." +
+                std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) + ".tmp");
+            {
+                std::ofstream output(temporary);
+                output << io::json::stringify(io::json::Value::make_object({
+                    {"key", io::json::Value::make_string(profile_key_)},
+                    {"policies", io::json::Value::make_array(std::move(values))}
+                }));
+                output.close();
+                if (!output) throw std::runtime_error("cannot write cooperative calibration profile");
+            }
+            std::error_code error;
+            std::filesystem::rename(temporary, path, error);
+            if (error) {
+                // Windows rename cannot replace an existing invalid cache file.
+                std::filesystem::remove(path, error);
+                error.clear();
+                std::filesystem::rename(temporary, path, error);
+            }
+            if (error) std::filesystem::remove(temporary, error);
+            else debug::timing_log_scalar("drama3.hybrid.profile_saved", 1);
+        } catch (const std::exception &) {
+            debug::timing_log_scalar("drama3.hybrid.profile_write_failed", 1);
+        }
+        // Optional cache persistence must not prevent an otherwise valid request.
+        profile_saved_ = true;
+    }
+    core::ExecutionContext & execution_;
+    const Drama3BackboneWeights & weights_;
+    Drama3BackboneDecoderConfig config_;
+    ggml_tensor * x_;
+    core::ExecutionContext cpu_;
+    Context context_, cpu_context_, inputs_, cpu_inputs_;
+    Buffer device_buffer_, host_buffer_, handoff_;
+    Allocator gpu_allocator_, cpu_allocator_;
+    std::vector<ggml_cgraph *> gpu_graphs_, cpu_graphs_, route_graphs_, shared_graphs_, cpu_scatter_;
+    std::vector<std::vector<ggml_cgraph *>> gpu_experts_, cpu_experts_;
+    std::map<ggml_cgraph *, core::HostGraphPlan> cpu_plans_;
+    ggml_cgraph * finish_ = nullptr, * final_ = nullptr;
+    ggml_tensor * hidden_, * residual_, * shared_, * scales_, * ids_, * gpu_slots_, * gpu_lanes_, * cpu_lanes_;
+    ggml_tensor * partial_, * uploaded_, * final_hidden_, * cpu_x_, * cpu_ids_, * cpu_output_;
+    float * host_x_, * host_partial_;
+    int32_t * host_ids_;
+    std::vector<Policy> policies_;
+    std::string profile_key_;
+    std::filesystem::path profile_path_;
+    bool profile_saved_ = false;
+    bool compatible_quantization_ = false;
+    QuantGuard input_guard_{}, activation_guard_{};
+    std::atomic<unsigned int> boundary_mask_{0};
+    uint64_t cpu_jobs_ = 0, gpu_jobs_ = 0, guarded_jobs_ = 0;
+    std::unique_ptr<Drama3ExpertWorker> worker_;
+};
