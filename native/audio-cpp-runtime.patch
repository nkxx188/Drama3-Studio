+    }
+    ~Drama3ExpertWorker() {
+        { std::lock_guard<std::mutex> lock(mutex_); stop_ = true; }
+        condition_.notify_all();
+        thread_.join();
+    }
+    void launch(std::function<void()> task) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!done_) throw std::runtime_error("Drama 3 CPU expert worker is busy");
+        task_ = std::move(task); error_ = nullptr; done_ = false; pending_ = true;
+        condition_.notify_all();
+    }
+    void wait() {
+        std::unique_lock<std::mutex> lock(mutex_);
+        condition_.wait(lock, [&] { return done_; });
+        if (error_) std::rethrow_exception(error_);
+    }
+private:
+    std::thread thread_;
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    std::function<void()> task_;
+    std::exception_ptr error_;
+    bool stop_ = false, pending_ = false, done_ = true;
+};
+
+class Drama3HybridDecodeGraph {
+    using Context = std::unique_ptr<ggml_context, GgmlContextDeleter>;
+    using Buffer = std::unique_ptr<std::remove_pointer_t<ggml_backend_buffer_t>,
+                                   decltype(&ggml_backend_buffer_free)>;
+    using Allocator = std::unique_ptr<std::remove_pointer_t<ggml_gallocr_t>, GgmlGallocrDeleter>;
+    struct Policy {
+        int calls = 0, chosen = -1;
+        std::array<double, 3> total{};
+        std::array<int, 3> samples{};
+    };
+    struct QuantGuard { Drama3HybridDecodeGraph * owner; bool shared_input; };
+public:
+    Drama3HybridDecodeGraph(core::ExecutionContext & execution, const Drama3BackboneWeights & weights,
+        const Drama3BackboneDecoderConfig & config, ggml_tensor * input, ggml_tensor * positions,
+        ggml_tensor * cache_slot, ggml_tensor * mask, int64_t cache_steps,
+        const std::vector<ggml_tensor *> & keys, const std::vector<ggml_tensor *> & values,
+        const std::vector<ggml_tensor *> & tails, const std::vector<ggml_tensor *> & states)
+        : execution_(execution), weights_(weights), config_(config), x_(input),
+          cpu_(core::BackendConfig{core::BackendType::Cpu, 0, std::max(1, std::min(4, execution.config().threads))}),
+          device_buffer_(nullptr, ggml_backend_buffer_free),
+          host_buffer_(nullptr, ggml_backend_buffer_free), handoff_(nullptr, ggml_backend_buffer_free) {
+        const auto h = config.hidden_size, k = config.experts_per_token;
+        if (const auto * value = std::getenv("DRAMA_GGUF_PIPELINE_WIDTH"))
+            pipeline_width_ = static_cast<size_t>(std::atoi(value));
+        compatible_quantization_ = std::getenv("DRAMA_Q8_RAW_CPU") == nullptr;
+        input_guard_ = {this, true}; activation_guard_ = {this, false};
+        if (k != 8 || h != 2048 || !weights.disk_store)
+            throw std::runtime_error("cooperative decode currently supports native Drama 3 top-8");
+        context_.reset(ggml_init({32 * 1024 * 1024, nullptr, true}));
+        cpu_context_.reset(ggml_init({16 * 1024 * 1024, nullptr, true}));
+        inputs_.reset(ggml_init({1024 * 1024, nullptr, true}));
+        cpu_inputs_.reset(ggml_init({1024 * 1024, nullptr, true}));
